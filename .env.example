# Salin menjadi .env lalu isi nilainya. File .env tidak boleh di-commit.

# Wajib: WhatsApp Cloud API
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=

# Wajib: Google Sheets. Isi dengan JSON Service Account satu baris,
# atau hasil base64 dari file JSON-nya (base64 -w0 service-account.json).
GOOGLE_SA_JSON=
SHEET_ID=

# Opsional (nilai bawaan di dalam kurung)
# WA_API_VERSION=v25.0
# SHEET_TAB=FAQ
# FAQ_CACHE_TTL=60
# PORT=3000
# HOST=0.0.0.0
