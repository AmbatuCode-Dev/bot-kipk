{
  "name": "bot-kipk",
  "version": "0.1.0",
  "private": true,
  "description": "Bot WhatsApp FAQ Forum KIP-Kuliah UNJ - Proyek Akhir Manajemen Proyek",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "cek:sheets": "node --env-file-if-exists=.env scripts/cek-sheets.js",
    "cek:wa": "node --env-file-if-exists=.env scripts/cek-wa.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@googleapis/sheets": "^18.1.3"
  }
}
